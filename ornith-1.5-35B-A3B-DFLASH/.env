# Ready-to-run defaults for one DGX Spark. Edit values here only if needed.
# This file is sourced as shell code. Quote paths that contain spaces.
# Never put access tokens or other secrets in this tracked file.

# The Hugging Face Hub cache is also vLLM's default weight download location.
# Respect HF_HUB_CACHE, HF_HOME, and XDG_CACHE_HOME when users set them.
HF_HUB_CACHE=${HF_HUB_CACHE:-${HF_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/huggingface}/hub}
# This recipe's downloader environment is separate from other recipes.
HF_VENV=${XDG_CACHE_HOME:-$HOME/.cache}/ornith-1.5-35b-a3b-dflash/hf-venv
# "auto" loads the downloaded snapshot from HF_HUB_CACHE. Set a local path
# to use existing weights without copying them into the cache.
MODEL_DIR=auto
DRAFT_DIR=auto
AUTO_DOWNLOAD=1
MODEL_REPO=ornith-ai/Ornith-1.5-35B-A3B-NVFP4
DRAFT_REPO=ornith-ai/Ornith-1.5-35B-A3B-DFlash

# Verified on a single GB10 with the target and DFlash draft above.
IMAGE=vllm/vllm-openai:v0.27.1
CONTAINER_NAME=vllm-ornith-1.5-35b-a3b-dflash
SERVED_MODEL_NAME=ornith-1.5-35b-a3b
HOST=127.0.0.1
PORT=8000
GPU_MEMORY_UTILIZATION=0.42
MAX_MODEL_LEN=100000
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
SPECULATIVE_TOKENS=8
STARTUP_TIMEOUT=900
MIN_AVAILABLE_GIB=55
MIN_FREE_TARGET_GIB=30
MIN_FREE_DRAFT_GIB=2
MIN_FREE_IMAGE_GIB=12
