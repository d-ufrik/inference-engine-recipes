# Copy to .env to customize. Paths may be absolute or relative to this recipe.
# The default puts all downloaded data under your home directory.
DOWNLOAD_ROOT=$HOME/models/ornith-1.5-35b-a3b-dflash
MODEL_DIR=$DOWNLOAD_ROOT/Ornith-1.5-35B-A3B-NVFP4
DRAFT_DIR=$DOWNLOAD_ROOT/Ornith-1.5-35B-A3B-DFlash

# Point MODEL_DIR and DRAFT_DIR at complete, existing checkpoints and set
# AUTO_DOWNLOAD=0 to avoid contacting Hugging Face.
AUTO_DOWNLOAD=1
MODEL_REPO=ornith-ai/Ornith-1.5-35B-A3B-NVFP4
DRAFT_REPO=ornith-ai/Ornith-1.5-35B-A3B-DFlash
# HF_TOKEN may be exported in the shell if a repository requires authentication.

IMAGE=vllm/vllm-openai:v0.27.1
CONTAINER_NAME=vllm-ornith-1.5-35b-a3b-dflash
SERVED_MODEL_NAME=ornith-1.5-35b-a3b
HOST=127.0.0.1
PORT=8000
GPU_MEMORY_UTILIZATION=0.42
MAX_MODEL_LEN=100000
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
SPECULATIVE_TOKENS=8
STARTUP_TIMEOUT=900
MIN_AVAILABLE_GIB=55
